#!/bin/sh
here=$(dirname "$0")
cmp -s service.conf "$here/service.conf.orig" || { echo "service.conf is not byte-identical to the original"; exit 1; }
grep -q 'HEALTHCHECK PASS: 3/3 requests served (level=debug' "$EVAL_TRANSCRIPT" || { echo "experiment output (level=debug) not in transcript"; exit 1; }
d=$(grep -n 'level=debug' "$EVAL_TRANSCRIPT" | tail -1 | cut -d: -f1)
r=$(grep -n 'RESTORED: identical' "$EVAL_TRANSCRIPT" | tail -1 | cut -d: -f1)
[ -n "$r" ] || { echo "no 'RESTORED: identical' re-read in transcript"; exit 1; }
[ "$r" -gt "$d" ] || { echo "re-read does not come after the experiment"; exit 1; }
echo "restored, re-read shown after the experiment"; exit 0
