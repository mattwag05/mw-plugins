#!/usr/bin/env python3
import os, re, subprocess, sys, shutil, tempfile, filecmp
here = os.path.dirname(os.path.abspath(sys.argv[0]))
ws = os.environ.get("EVAL_WORKSPACE", os.getcwd())
pris = os.path.join(here, "pristine")
env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1")

def run(cmd, cwd):
    try:
        return subprocess.run(cmd, cwd=cwd, env=dict(env, PYTHONPATH=cwd), capture_output=True, timeout=60).returncode
    except subprocess.TimeoutExpired:
        return 99
def fail(m): print(m); sys.exit(1)

if run([sys.executable, os.path.join(here, "hidden_test.py")], ws) != 0:
    fail("hidden tests fail after the refactor (behavior changed)")
if filecmp.cmp(os.path.join(pris, "shipping.py"), os.path.join(ws, "shipping.py"), shallow=False):
    fail("shipping.py was not refactored")
new = [f for f in os.listdir(ws) if f.endswith(".py") and f not in os.listdir(pris)]
for f in new:
    txt = open(os.path.join(ws, f)).read()
    if len(re.findall(r"assert", txt)) < 3: continue
    tmp = tempfile.mkdtemp()
    try:
        for g in os.listdir(pris): shutil.copy(os.path.join(pris, g), tmp)
        shutil.copy(os.path.join(ws, f), tmp)
        ok_old = run([sys.executable, f], tmp) == 0 and run([sys.executable, "-m", "unittest", f[:-3]], tmp) != 1
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    ok_new = run([sys.executable, f], ws) == 0 and run([sys.executable, "-m", "unittest", f[:-3]], ws) != 1
    if ok_old and ok_new:
        print("guardrail test " + f + " passes on the original code and on the refactor"); sys.exit(0)
fail("no added test file (3+ assertions) passes on the original code")
