+++ b/test_slug.py
@@ -0,0 +1,15 @@
+import unittest
+from slug import slugify
+
+
+class T(unittest.TestCase):
+    def test_simple(self):
+        self.assertEqual(slugify("Hello World"), "hello-world")
+
+    def test_punctuation(self):
+        self.assertEqual(slugify("Hello,  World!"), "hello---world")
+
+    def test_edges(self):
+        self.assertEqual(slugify("--Hi--"), "hi")
+
+
+if __name__ == "__main__":
+    unittest.main()
