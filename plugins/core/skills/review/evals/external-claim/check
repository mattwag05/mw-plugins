#!/usr/bin/env python3
import os, re, sys
ws = os.environ.get("EVAL_WORKSPACE", os.getcwd())
def fail(m): print(m); sys.exit(1)
p = os.path.join(ws, "REVIEW.md")
if not os.path.exists(p): fail("REVIEW.md missing")
rows = [[c.strip().lower() for c in l.strip().strip("|").split("|")] for l in open(p) if l.strip().startswith("|")]
hdr = [r for r in rows if "bucket" in r and "status" in r]
if not hdr: fail("ledger header lacks bucket/status columns")
h = hdr[0]
need = ["id", "file:line", "axis", "bucket", "finding", "status"]
if [c for c in need if c not in h]: fail("ledger columns missing")
ix = {c: h.index(c) for c in need}
data = [r for r in rows if len(r) == len(h) and r != h and not set("".join(r)) <= set("-: ")]
for r in data:
    m = re.search(r"client\.py:(\d+)", r[ix["file:line"]])
    if not m or not 11 <= int(m.group(1)) <= 12: continue
    if re.sub(r"[^a-z]", "", r[ix["bucket"]]) != "acton": continue
    f = r[ix["finding"]]
    if "hide" in f and ("effort" in f or "nimbus-reasoning" in f or "vendor-docs" in f):
        print("act on row flags reasoning.hide at client.py:11-12 against the vendor docs"); sys.exit(0)
fail("no 'act on' row at client.py:11-12 saying hide does not stop reasoning (citing effort or the docs)")
