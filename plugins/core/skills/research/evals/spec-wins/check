#!/usr/bin/env python3
import glob, sys
fs = glob.glob("research/*.md")
def fail(m): print(m); sys.exit(1)
if not fs: fail("no research/<slug>.md")
t = open(fs[0], encoding="utf-8").read()
if "47" not in t: fail("answer lacks the spec value 47")
if "quill-spec.md" not in t: fail("spec path not cited")
print("spec value and citation present")
