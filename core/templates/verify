#!/bin/sh
# verify: the one command an agent runs to check this repo. Copy to the repo root as ./verify,
# chmod +x, and replace the example checks. Runs every check, then exits:
#   0 all passed, 1 any failed, 2 none failed but a check was skipped (missing tool = open gate).
cd "$(dirname "$0")" || exit 1
fails=0; skips=0; log=$(mktemp); trap 'rm -f "$log"' EXIT

# check NAME CMD...: run CMD; print PASS or FAIL with its last output lines.
check() {
  name=$1; shift
  if "$@" >"$log" 2>&1; then echo "PASS $name"
  else echo "FAIL $name"; tail -15 "$log" | sed 's/^/     /'; fails=$((fails + 1)); fi
}
# need TOOL NAME: return 1 (and count a skip) if TOOL is not installed.
need() {
  command -v "$1" >/dev/null 2>&1 && return 0
  echo "SKIP $2 ($1 not installed)"; skips=$((skips + 1)); return 1
}

# --- checks: replace these -------------------------------------------------
check "unit tests" python3 -m unittest discover -s tests
need gitleaks "secret scan" && check "secret scan" gitleaks dir --no-banner --redact .
# ---------------------------------------------------------------------------

echo "verify: $fails failed, $skips skipped"
[ "$fails" -gt 0 ] && exit 1
[ "$skips" -gt 0 ] && exit 2
exit 0
