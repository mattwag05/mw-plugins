#!/bin/sh
# READY verdict, PR body sections, nothing pushed or rewritten.
[ -f SHIP.md ] || { echo "SHIP.md missing"; exit 1; }
v=$(grep -m1 -iE '^verdict:' SHIP.md)
echo "$v" | grep -qiE '^verdict:[[:space:]]*\**READY' || { echo "verdict is not READY: $v"; exit 1; }
for s in problem change proof; do
  grep -qiE "^#+[[:space:]]*$s" SHIP.md || { echo "PR body section '$s' missing"; exit 1; }
done
[ -z "$(git remote)" ] || { echo "a remote exists"; exit 1; }
git merge-base --is-ancestor "$(cat .git/eval-head)" HEAD || { echo "history was rewritten"; exit 1; }
[ "$(git rev-list --count HEAD)" -le 3 ] || { echo "extra commits"; exit 1; }
echo "READY with problem/change/proof, no push"; exit 0
