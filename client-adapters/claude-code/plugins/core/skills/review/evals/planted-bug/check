#!/usr/bin/env python3
import os, re, sys
ws = os.environ.get("EVAL_WORKSPACE", os.getcwd())
def fail(m): print(m); sys.exit(1)
p = os.path.join(ws, "REVIEW.md")
if not os.path.exists(p): fail("REVIEW.md missing")
rows = [[c.strip().lower() for c in l.strip().strip("|").split("|")] for l in open(p) if l.strip().startswith("|")]
hdr = [r for r in rows if "bucket" in r and "status" in r]
if not hdr: fail("ledger header lacks bucket/status columns")
h = hdr[0]
need = ["id", "file:line", "axis", "bucket", "finding", "status"]
if [c for c in need if c not in h]: fail("ledger columns missing: " + ",".join(c for c in need if c not in h))
ix = {c: h.index(c) for c in need}
data = [r for r in rows if len(r) == len(h) and r != h and not set("".join(r)) <= set("-: ")]
def bucket(r): return re.sub(r"[^a-z]", "", r[ix["bucket"]])
bug_ok = nit_act = False
for r in data:
    m = re.search(r"cart\.py:(\d+)", r[ix["file:line"]])
    if not m: continue
    n = int(m.group(1))
    if bucket(r) == "acton":
        if 13 <= n <= 14: bug_ok = True      # the >= comparison (line 13)
        if n == 12: nit_act = True           # variable-name nit (line 12)
if not bug_ok: fail("no 'act on' row flags cart.py near line 13 (the >= bug)")
if nit_act: fail("harmless naming nit was put in 'act on'")
print("REVIEW.md ledger flags the >= bug at cart.py:13 as act on"); sys.exit(0)
