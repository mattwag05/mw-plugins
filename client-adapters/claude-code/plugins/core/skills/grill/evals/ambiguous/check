#!/bin/sh
# Pass only if the agent asked numbered questions with recommendations and changed nothing.
here="$(dirname "$0")"
[ -n "$EVAL_TRANSCRIPT" ] || { echo "no transcript"; exit 1; }
nq=$(grep -Ec '^[[:space:]*#>-]*(Q|Question )?[0-9]+[.):]' "$EVAL_TRANSCRIPT")
nr=$(grep -Eic 'recommend' "$EVAL_TRANSCRIPT")
[ "$nq" -ge 2 ] || { echo "fewer than 2 numbered questions"; exit 1; }
[ "$nr" -ge 2 ] || { echo "fewer than 2 recommendation markers"; exit 1; }
diff -r "$here/orig" "${EVAL_WORKSPACE:-.}" >/dev/null 2>&1 || { echo "workspace changed; agent acted before confirmation"; exit 1; }
echo "numbered questions with recommendations, no changes"
